# ============================================================
# TRIRIGA ↔ Kontracts Integration Platform - Environment Config
# Copy to .env and fill in your values
# ============================================================

# -------------------------------------------------------
# Database
# -------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/tririga_kontracts
# For local dev (no docker): postgresql+asyncpg://postgres:postgres@localhost:5432/tririga_kontracts

# -------------------------------------------------------
# Security - REQUIRED
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -------------------------------------------------------
FERNET_KEY=your_generated_fernet_key_here

# -------------------------------------------------------
# Application
# -------------------------------------------------------
DEMO_MODE=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# -------------------------------------------------------
# TRIRIGA SOAP API
# -------------------------------------------------------
TRIRIGA_URL=https://tri-demo.kontracts.pro
TRIRIGA_USERNAME=ssystem
TRIRIGA_PASSWORD=smarter
TRIRIGA_WSDL_PATH=/ws/TririgaWS?wsdl

# -------------------------------------------------------
# Kontracts REST API (Auth0)
# -------------------------------------------------------
KONTRACTS_BASE_URL=https://your-kontracts-api.example.com
KONTRACTS_AUTH0_DOMAIN=your-tenant.auth0.com
KONTRACTS_CLIENT_ID=your_auth0_client_id
KONTRACTS_CLIENT_SECRET=your_auth0_client_secret
KONTRACTS_AUDIENCE=https://your-kontracts-api.example.com

# -------------------------------------------------------
# Frontend
# -------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
